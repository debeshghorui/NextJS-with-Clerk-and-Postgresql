{
    "name": "nextjs-with-clerk-and-postgresql",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.14",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "prisma:format": "bunx --bun prisma format",
        "prisma:generate": "bunx --bun prisma generate",
        "prisma:migrate": "bunx --bun prisma migrate dev",
        "prisma:studio": "bunx --bun prisma studio",
        "format": "prettier --write \"**/*.{mjs,cjs,js,jsx,ts,tsx,json,css,md}\"",
        "lint": "eslint",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*.{mjs,cjs,js,jsx,ts,tsx,json,css,md}": "prettier --write"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@clerk/nextjs": "^7.5.20",
        "@prisma/adapter-pg": "^7.9.0",
        "@prisma/client": "^7.9.0",
        "@remixicon/react": "^4.9.0",
        "@shadcn/react": "^0.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "next": "16.2.10",
        "next-themes": "^0.4.6",
        "react": "19.2.4",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.4",
        "react-resizable-panels": "^4.12.2",
        "recharts": "3.8.0",
        "shadcn": "^4.13.1",
        "sonner": "^2.0.7",
        "svix": "^1.99.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^26.1.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.2.10",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.1.0",
        "prettier": "^3.9.5",
        "prisma": "^7.9.0",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ]
}
